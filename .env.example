# autoRun 密钥与环境变量。
#
#   cp .env.example .env
#   chmod 600 .env          # 必须：权限过宽时服务拒绝启动
#
# 服务启动时自动读取项目根目录的 .env，无需手动 export。
# config.yaml 里用 ${变量名} 引用这里的值，密钥本身不会写进 YAML。
#
# 生成一个强密钥：
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
#
# 语法说明：
#   KEY=value              普通赋值
#   KEY="a b # c"          值中含空格、# 或首尾空白时**必须加引号**，
#                          否则空白之后的 # 会被当作行内注释截掉
#   KEY='literal$value'    单引号内完全字面量，不做任何转义（适合含 $ 和 \ 的密钥）
#   export KEY=value       兼容此写法，便于同一个文件也能被 shell source
#
# 优先级：已存在的环境变量优先，.env 不覆盖它们。因此
#   AUTORUN_KEY_ADMIN=xxx python -m autorun foreground
# 可以临时压过文件里的值。

# 管理员密钥（可执行全部别名、裸命令与 kill）
AUTORUN_KEY_ADMIN=请替换为_python -c 'import secrets;print(secrets.token_urlsafe(32))'_的输出


# CI 专用密钥（最小权限调用方）。给 CI/CD、脚本、机器人用：在 config.yaml 的
# auth.keys 里配一个 id: ci-bot 的条目，用 allowed_aliases 限定它只能跑指定别名、
# allow_raw: false 禁止裸命令。仅当在 config.yaml 中启用了该条目时才需要设值。
# AUTORUN_KEY_CI=

# --- 邮件告警（可选）---------------------------------------------------------
# 仅当 config.yaml 的 gpu_monitor 配了 email 动作时才需要，smtp 段通过
# ${SMTP_USER} / ${SMTP_PASS} 引用这两个变量。
#   SMTP_USER  登录 SMTP 的账号 = 你的完整邮箱地址（如 alice@163.com）
#   SMTP_PASS  客户端授权码，不是邮箱登录密码！在邮箱网页版开启 SMTP 后获取
# 注意 163/QQ 要求 config.yaml 里的 from_addr 与 SMTP_USER 是同一个邮箱。
# SMTP_USER=alice@163.com
# SMTP_PASS=请替换为邮箱的客户端授权码